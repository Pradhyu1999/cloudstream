<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/server_section_title"
        style="@style/WatchHeaderText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/server_open_ratings"
        android:focusable="true"
        android:foreground="@drawable/outline_drawable"
        android:padding="12dp"
        android:text="@string/server_ratings_title"
        app:drawableEndCompat="@drawable/ic_baseline_arrow_forward_24"
        app:drawableTint="?attr/white" />

    <TextView
        android:id="@+id/server_section_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/server_ratings_hint"
        android:textColor="?attr/grayTextColor"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/server_section_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/server_empty"
        android:textColor="?attr/textColor"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_section_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/server_section_title"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_server_rating" />
</LinearLayout>
